# ============================================
# .gitignore - ConnectWiseControlAPI
# ============================================

# ---- Project-Specific ----
Scratch*.ps1
output/
coverage.xml
testResults.xml
nul
*-help.xml

# ---- Operating Systems ----

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.nfs*

# ---- IDEs and Editors ----

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docuser

# JetBrains (Rider, IntelliJ)
.idea/
*.iml

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
tags

# ---- PowerShell ----
modules/
*.dll
*.pdb

# ---- Build Artifacts ----
bin/
obj/
artifacts/
publish/
*.nupkg

# ---- Security & Secrets ----
.env
.env.*
*.pfx
*.key
*.pem
*.p12
*credentials*
*secret*
!.github/SECURITY.md
# Source, tests and docs are never secrets, even when a name matches (e.g. Test-CWCApiSecretConnection.ps1)
!ConnectWiseControlAPI/**/*.ps1
!ConnectWiseControlAPI/en-US/*-help.xml
!Tests/**/*.ps1
!Docs/**/*.md

# ---- Claude Code ----
.claude/settings.local.json
.claude/plan.md

# ---- Logs & Temp ----
*.log
logs/
temp/
tmp/
*.tmp
*.bak
*.swp
