# ============================================
# .gitignore - ConnectWiseControlAPI
# ============================================

# ---- Project-Specific ----
Scratch*.ps1
output/
coverage.xml
testResults.xml
nul

# ---- Operating Systems ----

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.nfs*

# ---- IDEs and Editors ----

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docuser

# JetBrains (Rider, IntelliJ)
.idea/
*.iml

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
tags

# ---- PowerShell ----
modules/
*.dll
*.pdb

# ---- Build Artifacts ----
bin/
obj/
artifacts/
publish/
*.nupkg

# ---- Security & Secrets ----
.env
.env.*
*.pfx
*.key
*.pem
*.p12
# Secret *data* files only (Export-Clixml credentials, secret JSON/text). Not name-only patterns like
# *secret*: those matched module source such as Test-CWCApiSecretConnection.ps1.
secrets/
*.secret
*credential*.xml
*credential*.json
*secret*.xml
*secret*.json
*secret*.txt

# ---- Claude Code ----
.claude/settings.local.json
.claude/plan.md

# ---- Logs & Temp ----
*.log
logs/
temp/
tmp/
*.tmp
*.bak
*.swp
